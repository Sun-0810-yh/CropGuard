# runs/train/pest27_final4/weights/best.onnx

# --- 临时/探索产物（不入库；现场生成的文件）---
.dsh-tmp/
real_test*/

# --- EdgeJev 本地决策模型（构建产物，本机生成不入库；构建见 scripts/build_edge_model.py）---
edge_models/*/*
!edge_models/*/README.md
# 构建过程中 tempfile 产生的临时目录（Windows 沙箱下可能 ACL 异常，直接忽略）
edge_models/t_*/
.edge-build-venv/

# --- 数据集（体积过大，不入库）---
dataset/
dataset_full/
dataset_102/
competition_all_sorted/
pictures20/*
!pictures20/README.md
selected_real_scenes/
# 真实样本测试集：只提交脚本与 README 里的口径，图片（1.1MB, 20 张）不入库，可用 pick_real_testset.py 重建
real_testset20/
# 到货标本的实拍图（按采购单编号 01.jpg…）：图片不入库；采购单 docs/specimens_plan.csv 入库
specimens/

# --- 竞赛材料（PPT/规则文档，不公开）---
睿抗国赛项目—株得/

# --- 输出结果 ---
output/
runs/

# --- HTTPS 自签证书（本机生成，不入库）---
config/certs/

# --- Python 缓存与环境 ---
__pycache__/
*.pyc
*.pyo
.env
.venv/
venv/
env/

# --- IDE 配置 ---
.vscode/
.idea/

# --- 日志与临时文件 ---
*.log
.DS_Store
Thumbs.db

# --- Docker (可选) ---
.dockerignore

# --- 独立发布的子仓库（内含自己的 .git，别当成本仓库的文件）---
_dist/

# --- 前端源码依赖（构建产物 web/dist 要提交，node_modules 不提交）---
web/node_modules/

# 现场在 /demo 里改的喷淋节点地址（每台机器/每个热点都不同，不入库）
config/spray_targets.local.json

# 实体标本微调数据集（含手拍照片，不入库；用 scripts/build_specimen_dataset.py 重建）
datasets/
