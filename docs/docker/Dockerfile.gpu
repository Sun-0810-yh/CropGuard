# syntax=docker/dockerfile:1
# ============================================================
# CropGuard GPU Dockerfile (CUDA 11.8)
# 102类农业害虫检测系统 - GPU版本
# 构建: docker build -f docs/docker/Dockerfile.gpu -t pest-detection:gpu .
# 运行: docker run --gpus all -p 8080:8080 pest-detection:gpu
# ============================================================
FROM nvidia/cuda:11.8.0-cudnn8-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive

# 系统依赖
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-pip python3-venv \
    build-essential \
    git \
    curl \
    ca-certificates \
    libgl1 \
    libglib2.0-0 \
    libxext6 libxrender1 libsm6 \
    libgomp1 \
    xvfb \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# 安装 Python 依赖 + GPU PyTorch
COPY requirements-server.txt ./
RUN python3 -m pip install --upgrade pip \
    && pip install --no-cache-dir -r requirements-server.txt \
    && pip install --no-cache-dir torch torchvision --index-url https://download.pytorch.org/whl/cu118

# 复制项目文件
COPY . .

# 创建输出目录
RUN mkdir -p output

ENV PYTHONUNBUFFERED=1 \
    QT_X11_NO_MITSHM=1

EXPOSE 8080

# GPU 版本使用 GPU 推理 (在 configs.yaml 中设置 DEVICE: '0')
CMD ["python3", "api_server.py", "--host", "0.0.0.0", "--port", "8080"]
